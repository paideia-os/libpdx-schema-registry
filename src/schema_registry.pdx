// src/schema_registry.pdx — libpdx-schema-registry.M2-002
// SchemaRegistry: the client-side register/lookup/list API landed one
// milestone at a time. This file lands M2-002 (schema_register); M2-003
// (schema_lookup) and M2-004 (schema_list) extend it in place; M3-001
// (audit hook) and M3-002 (elevate gate) extend schema_register in
// place with additional prelude gates.
//
// paideia-as conformance:
//   - Module basename PascalCase; no directory prefix.
//   - No `test` mnemonic — every branch uses cmp reg,imm + je / jne / ja.
//   - r11 = scratch — used for RIP-relative LEA staging and per-slot
//     base pointer arithmetic in the two scan loops.
//   - Loop counter compared against SR_MAX_SCHEMAS (32) which fits
//     imm8; length gates compared against SR_MAX_FQNAME_LEN (64)
//     which fits imm8.
//   - Callee-save preservation across the three nested calls to
//     SchemaHash::schema_hash_init / _update / _finalize: 5-push
//     prologue (rbx / r12 / r13 / r14 / r15) preserves the four
//     argument pointers plus the finalized content hash.
//
// Cross-module symbols read/written (all in SchemaRecord .bss):
//   schema_slot_state[i], schema_id[i], schema_content_hash[i],
//   schema_fqname_ptr[i], schema_fqname_len[i],
//   schema_body_ptr[i], schema_body_len[i], schema_id_next
// Cross-module functions called (all in SchemaHash):
//   schema_hash_init, schema_hash_update, schema_hash_finalize
// Cross-module constants referenced (all in SchemaRecord):
//   SR_OK, SR_ERR_NULL_NAME, SR_ERR_NAME_RANGE, SR_ERR_NULL_BODY,
//   SR_ERR_ENOSPC, SR_MAX_SCHEMAS (32), SR_MAX_FQNAME_LEN (64),
//   SR_SLOT_EMPTY (0), SR_SLOT_OCCUPIED (1)

module SchemaRegistry = structure {

  // ============================================================================
  // schema_register(fqname_ptr, fqname_len, body_ptr, body_len) -> u64
  //   rdi = fqname_ptr        (NUL-terminated OR length-explicit; the
  //                             library treats fqname_len as authoritative
  //                             and never walks past it)
  //   rsi = fqname_len        (must be in [1, SR_MAX_FQNAME_LEN])
  //   rdx = body_ptr          (schema body bytes; opaque to the library)
  //   rcx = body_len          (may be 0 for a zero-body schema — legal;
  //                             hashes to the FNV_OFFSET_BASIS baseline)
  //   rax = assigned id (>0)  on success
  //       | SR_ERR_NULL_NAME  (1)
  //       | SR_ERR_NAME_RANGE (2)
  //       | SR_ERR_NULL_BODY  (3)
  //       | SR_ERR_ENOSPC     (4) if the catalog has no free slot
  //
  // Behavior:
  //   1. Gate arguments (null / range) — early return without touching
  //      state on failure.
  //   2. Compute content_hash over body_ptr[0..body_len) via SchemaHash.
  //   3. Dedup scan: if any OCCUPIED slot has content_hash matching,
  //      return that slot's schema_id (no state mutation — a re-
  //      register of a byte-identical body is idempotent, same id).
  //   4. Free-slot scan: find first EMPTY slot; if none, SR_ERR_ENOSPC.
  //   5. Allocate id = schema_id_next; schema_id_next += 1; store all
  //      six per-slot fields, transition schema_slot_state[i] to
  //      OCCUPIED, return the newly-assigned id.
  //
  // Register plan across the 5-push prologue (rsp % 16 == 8 after CALL
  // → 8 + 5*8 = 48 → rsp % 16 == 0 for every nested call):
  //   rbx = fqname_ptr (arg, preserved across three nested calls)
  //   r12 = fqname_len (arg, preserved across three nested calls)
  //   r13 = body_ptr   (arg, staged into rdi for schema_hash_update)
  //   r14 = body_len   (arg, staged into rsi for schema_hash_update)
  //   r15 = content_hash (populated by schema_hash_finalize's rax)
  //
  // In-loop registers (both scans reuse the same shape):
  //   rcx = slot index i
  //   r10 = per-slot pointer scratch (base + i*8)
  //   r11 = LEA scratch for the current array's base
  //   rax = per-iteration load (state, hash, id, etc.)
  //
  // Effects `!{mem} @{}` — no syscall, no cap. Pure library-owned
  // state; the effect surface matches SchemaHash's own trio.
  // ============================================================================

  pub let schema_register : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (fqname_ptr: u64) (fqname_len: u64) (body_ptr: u64) (body_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-schema-registry.M2-002: schema_register entry point. Argument gates evaluated inline before the callee-save prologue so the null/range paths return without a push/pop dance: fqname_ptr == 0 → SR_ERR_NULL_NAME (1); fqname_len == 0 OR fqname_len > SR_MAX_FQNAME_LEN (64) → SR_ERR_NAME_RANGE (2); body_ptr == 0 → SR_ERR_NULL_BODY (3). Note body_len == 0 is legal (a zero-body schema hashes to the FNV_OFFSET_BASIS baseline, still a well-defined content hash — no gate on it). After the gates, push rbx/r12/r13/r14/r15 (5 = 40 bytes) so rsp %16 = 0 for the three nested calls to SchemaHash::schema_hash_init / _update / _finalize (all follow SysV). Move args to callee-saves: rbx=fqname_ptr, r12=fqname_len, r13=body_ptr, r14=body_len. Call schema_hash_init (nullary, void). Stage body args for update: mov rdi,r13; mov rsi,r14; call schema_hash_update — its return is discarded because init just ran (schema_hash_active == 1 is guaranteed) so SR_ERR_HASH_INACTIVE cannot fire. Call schema_hash_finalize; capture rax in r15 as content_hash. Dedup scan: xor rcx,rcx; loop while rcx < 32: load schema_slot_state[i] via `lea r11,[rip+schema_slot_state]; mov r10,rcx; shl r10,3; add r10,r11; mov rax,[r10]`; if rax != SR_SLOT_OCCUPIED (1) skip; else load schema_content_hash[i] identically; cmp against r15; on match, load schema_id[i] into rax and jump to epilogue. Free-slot scan: xor rcx,rcx; loop while rcx < 32: load schema_slot_state[i]; if != SR_SLOT_EMPTY (0) advance; else fall through with rcx = free slot i. If loop exhausts, rax = SR_ERR_ENOSPC (4), jump to epilogue. Populate: load schema_id_next into r8, allocate handed-out id as r8, increment schema_id_next in .bss (write r8 + 1), store r8 at schema_id[rcx], store r15 at schema_content_hash[rcx], store rbx at schema_fqname_ptr[rcx], store r12 at schema_fqname_len[rcx], store r13 at schema_body_ptr[rcx], store r14 at schema_body_len[rcx], write SR_SLOT_OCCUPIED (1) at schema_slot_state[rcx]. rax = r8 (return id). Epilogue: pop r15/r14/r13/r12/rbx (reverse push order); ret. Every array store uses the same lea+shl+add idiom the dedup scan's loads use. No test mnemonic. Immediates: 0 (null/state-empty compares), 1 (SR_ERR_NULL_NAME / SR_SLOT_OCCUPIED write), 2 (SR_ERR_NAME_RANGE), 3 (SR_ERR_NULL_BODY / shl bit count), 4 (SR_ERR_ENOSPC), 32 (SR_MAX_SCHEMAS bound), 64 (SR_MAX_FQNAME_LEN bound) — all imm8 and well within 0x7FFFFFFF. Label prefix snr_ per project reserved-label discipline (bare 'ok'/'fail'/'loop' would collide with paideia-as keywords).",
      block: {
        // ---- Argument gates (pre-prologue, no push/pop required). ----
        cmp rdi, 0;
        je snr_null_name;

        cmp rsi, 0;
        je snr_name_range;
        cmp rsi, 64;                             // SR_MAX_FQNAME_LEN
        ja snr_name_range;

        cmp rdx, 0;
        je snr_null_body;

        // ---- Prologue: preserve four arg regs + hash-capture reg. ----
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                            // rbx = fqname_ptr
        mov r12, rsi;                            // r12 = fqname_len
        mov r13, rdx;                            // r13 = body_ptr
        mov r14, rcx;                            // r14 = body_len

        // ---- Compute content_hash via SchemaHash's trio. -------------
        call schema_hash_init;

        mov rdi, r13;                            // ptr
        mov rsi, r14;                            // len
        call schema_hash_update;
        // Return discarded — init just ran so INACTIVE cannot fire.

        call schema_hash_finalize;
        mov r15, rax;                            // r15 = content_hash

        // =============================================================
        // Dedup scan: any OCCUPIED slot with matching content_hash?
        // =============================================================
        xor rcx, rcx;                            // rcx = i = 0

      snr_dedup_head:
        cmp rcx, 32;                             // SR_MAX_SCHEMAS
        jae snr_dedup_done;

        // rax = schema_slot_state[i]
        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];

        cmp rax, 1;                              // SR_SLOT_OCCUPIED
        jne snr_dedup_advance;

        // rax = schema_content_hash[i]
        lea r11, [rip + schema_content_hash];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];

        cmp rax, r15;
        jne snr_dedup_advance;

        // Match — return the existing slot's id.
        lea r11, [rip + schema_id];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        jmp snr_epilogue;

      snr_dedup_advance:
        add rcx, 1;
        jmp snr_dedup_head;

      snr_dedup_done:
        // =============================================================
        // Free-slot scan: first EMPTY slot wins.
        // =============================================================
        xor rcx, rcx;                            // rcx = i = 0

      snr_free_head:
        cmp rcx, 32;                             // SR_MAX_SCHEMAS
        jae snr_no_space;

        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];

        cmp rax, 0;                              // SR_SLOT_EMPTY
        je snr_free_found;

        add rcx, 1;
        jmp snr_free_head;

      snr_no_space:
        mov rax, 4;                              // SR_ERR_ENOSPC
        jmp snr_epilogue;

      snr_free_found:
        // =============================================================
        // Allocate id from schema_id_next; then populate slot rcx.
        // =============================================================
        lea r11, [rip + schema_id_next];
        mov r8, [r11];                           // r8 = handed-out id
        mov rax, r8;
        add rax, 1;
        mov [r11], rax;                          // schema_id_next += 1

        // schema_id[i] = r8
        lea r11, [rip + schema_id];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r8;

        // schema_content_hash[i] = r15
        lea r11, [rip + schema_content_hash];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r15;

        // schema_fqname_ptr[i] = rbx
        lea r11, [rip + schema_fqname_ptr];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], rbx;

        // schema_fqname_len[i] = r12
        lea r11, [rip + schema_fqname_len];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r12;

        // schema_body_ptr[i] = r13
        lea r11, [rip + schema_body_ptr];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r13;

        // schema_body_len[i] = r14
        lea r11, [rip + schema_body_len];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r14;

        // schema_slot_state[i] = SR_SLOT_OCCUPIED (1)
        mov rax, 1;
        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], rax;

        mov rax, r8;                             // return the assigned id

      snr_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      snr_null_name:
        mov rax, 1;                              // SR_ERR_NULL_NAME
        ret;

      snr_name_range:
        mov rax, 2;                              // SR_ERR_NAME_RANGE
        ret;

      snr_null_body:
        mov rax, 3;                              // SR_ERR_NULL_BODY
        ret;
      }
    }
}
