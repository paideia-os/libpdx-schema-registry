// src/schema_registry.pdx — libpdx-schema-registry.M2-002 + M2-003 + M2-004 + M3-001
// SchemaRegistry: the client-side register/lookup/list API landed one
// milestone at a time. This file lands M2-002 (schema_register), M2-003
// (schema_lookup), M2-004 (schema_list), and M3-001 (audit-first gate
// on register — refuses when the caller has no libpdx-audit record
// open, per the D3 / I5 discipline the plan doc pins on any operation
// that mutates persistent state); M3-002 (elevate gate) extends
// schema_register in place with an additional prelude gate.
//
// paideia-as conformance:
//   - Module basename PascalCase; no directory prefix.
//   - No `test` mnemonic — every branch uses cmp reg,imm + je / jne / ja.
//   - r11 = scratch — used for RIP-relative LEA staging and per-slot
//     base pointer arithmetic in the two scan loops.
//   - Loop counter compared against SR_MAX_SCHEMAS (32) which fits
//     imm8; length gates compared against SR_MAX_FQNAME_LEN (64)
//     which fits imm8.
//   - Callee-save preservation across the three nested calls to
//     SchemaHash::schema_hash_init / _update / _finalize: 5-push
//     prologue (rbx / r12 / r13 / r14 / r15) preserves the four
//     argument pointers plus the finalized content hash.
//
// Cross-module symbols read/written (all in SchemaRecord .bss):
//   schema_slot_state[i], schema_id[i], schema_content_hash[i],
//   schema_fqname_ptr[i], schema_fqname_len[i],
//   schema_body_ptr[i], schema_body_len[i], schema_id_next
// Cross-module functions called (all in SchemaHash):
//   schema_hash_init, schema_hash_update, schema_hash_finalize
// Cross-module symbols read (M3-001, libpdx-audit AuditRecord .bss):
//   record_state — resolved by consumer's link against libpdx-audit;
//     this satellite compiles the reference as an unresolved external.
// Cross-module constants referenced (all in SchemaRecord):
//   SR_OK, SR_ERR_NULL_NAME, SR_ERR_NAME_RANGE, SR_ERR_NULL_BODY,
//   SR_ERR_ENOSPC, SR_ERR_NO_AUDIT (M3-001), SR_MAX_SCHEMAS (32),
//   SR_MAX_FQNAME_LEN (64), SR_SLOT_EMPTY (0), SR_SLOT_OCCUPIED (1)

module SchemaRegistry = structure {

  // ============================================================================
  // schema_register(fqname_ptr, fqname_len, body_ptr, body_len) -> u64
  //   rdi = fqname_ptr        (NUL-terminated OR length-explicit; the
  //                             library treats fqname_len as authoritative
  //                             and never walks past it)
  //   rsi = fqname_len        (must be in [1, SR_MAX_FQNAME_LEN])
  //   rdx = body_ptr          (schema body bytes; opaque to the library)
  //   rcx = body_len          (may be 0 for a zero-body schema — legal;
  //                             hashes to the FNV_OFFSET_BASIS baseline)
  //   rax = assigned id (>0)  on success
  //       | SR_ERR_NULL_NAME  (1)
  //       | SR_ERR_NAME_RANGE (2)
  //       | SR_ERR_NULL_BODY  (3)
  //       | SR_ERR_ENOSPC     (4) if the catalog has no free slot
  //
  // Behavior:
  //   1. Gate arguments (null / range) — early return without touching
  //      state on failure.
  //   2. Compute content_hash over body_ptr[0..body_len) via SchemaHash.
  //   3. Dedup scan: if any OCCUPIED slot has content_hash matching,
  //      return that slot's schema_id (no state mutation — a re-
  //      register of a byte-identical body is idempotent, same id).
  //   4. Free-slot scan: find first EMPTY slot; if none, SR_ERR_ENOSPC.
  //   5. Allocate id = schema_id_next; schema_id_next += 1; store all
  //      six per-slot fields, transition schema_slot_state[i] to
  //      OCCUPIED, return the newly-assigned id.
  //
  // Register plan across the 5-push prologue (rsp % 16 == 8 after CALL
  // → 8 + 5*8 = 48 → rsp % 16 == 0 for every nested call):
  //   rbx = fqname_ptr (arg, preserved across three nested calls)
  //   r12 = fqname_len (arg, preserved across three nested calls)
  //   r13 = body_ptr   (arg, staged into rdi for schema_hash_update)
  //   r14 = body_len   (arg, staged into rsi for schema_hash_update)
  //   r15 = content_hash (populated by schema_hash_finalize's rax)
  //
  // In-loop registers (both scans reuse the same shape):
  //   rcx = slot index i
  //   r10 = per-slot pointer scratch (base + i*8)
  //   r11 = LEA scratch for the current array's base
  //   rax = per-iteration load (state, hash, id, etc.)
  //
  // Effects `!{mem} @{}` — no syscall, no cap. Pure library-owned
  // state; the effect surface matches SchemaHash's own trio.
  // ============================================================================

  pub let schema_register : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (fqname_ptr: u64) (fqname_len: u64) (body_ptr: u64) (body_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-schema-registry.M2-002 + M3-001: schema_register entry point. Argument gates evaluated inline before the callee-save prologue so the null/range/audit-closed paths return without a push/pop dance: (M3-001) load AuditRecord::record_state via `lea r11,[rip+record_state]; mov rax,[r11]` (unresolved-external reference at .o time, resolved by the consumer's link against libpdx-audit) and refuse (SR_ERR_NO_AUDIT = 6) unless record_state IN {AUDIT_STATE_BEGUN (1), AUDIT_STATE_OUTPUT (2)} — the client-side D3 / I5 discipline the plan doc pins on any state-mutating op, forcing the caller to have an open audit context before the register can touch the catalog; fqname_ptr == 0 → SR_ERR_NULL_NAME (1); fqname_len == 0 OR fqname_len > SR_MAX_FQNAME_LEN (64) → SR_ERR_NAME_RANGE (2); body_ptr == 0 → SR_ERR_NULL_BODY (3). Note body_len == 0 is legal (a zero-body schema hashes to the FNV_OFFSET_BASIS baseline, still a well-defined content hash — no gate on it). After the gates, push rbx/r12/r13/r14/r15 (5 = 40 bytes) so rsp %16 = 0 for the three nested calls to SchemaHash::schema_hash_init / _update / _finalize (all follow SysV). Move args to callee-saves: rbx=fqname_ptr, r12=fqname_len, r13=body_ptr, r14=body_len. Call schema_hash_init (nullary, void). Stage body args for update: mov rdi,r13; mov rsi,r14; call schema_hash_update — its return is discarded because init just ran (schema_hash_active == 1 is guaranteed) so SR_ERR_HASH_INACTIVE cannot fire. Call schema_hash_finalize; capture rax in r15 as content_hash. Dedup scan: xor rcx,rcx; loop while rcx < 32: load schema_slot_state[i] via `lea r11,[rip+schema_slot_state]; mov r10,rcx; shl r10,3; add r10,r11; mov rax,[r10]`; if rax != SR_SLOT_OCCUPIED (1) skip; else load schema_content_hash[i] identically; cmp against r15; on match, load schema_id[i] into rax and jump to epilogue. Free-slot scan: xor rcx,rcx; loop while rcx < 32: load schema_slot_state[i]; if != SR_SLOT_EMPTY (0) advance; else fall through with rcx = free slot i. If loop exhausts, rax = SR_ERR_ENOSPC (4), jump to epilogue. Populate: load schema_id_next into r8, allocate handed-out id as r8, increment schema_id_next in .bss (write r8 + 1), store r8 at schema_id[rcx], store r15 at schema_content_hash[rcx], store rbx at schema_fqname_ptr[rcx], store r12 at schema_fqname_len[rcx], store r13 at schema_body_ptr[rcx], store r14 at schema_body_len[rcx], write SR_SLOT_OCCUPIED (1) at schema_slot_state[rcx]. rax = r8 (return id). Epilogue: pop r15/r14/r13/r12/rbx (reverse push order); ret. Every array store uses the same lea+shl+add idiom the dedup scan's loads use. No test mnemonic. Immediates: 0 (null/state-empty compares), 1 (SR_ERR_NULL_NAME / SR_SLOT_OCCUPIED write / AUDIT_STATE_BEGUN), 2 (SR_ERR_NAME_RANGE / AUDIT_STATE_OUTPUT), 3 (SR_ERR_NULL_BODY / shl bit count), 4 (SR_ERR_ENOSPC), 6 (SR_ERR_NO_AUDIT), 32 (SR_MAX_SCHEMAS bound), 64 (SR_MAX_FQNAME_LEN bound) — all imm8 and well within 0x7FFFFFFF. Label prefix snr_ per project reserved-label discipline (bare 'ok'/'fail'/'loop' would collide with paideia-as keywords).",
      block: {
        // ---- Gate 0 (M3-001): audit must be open (D3 / I5). ----------
        //      record_state is an AuditRecord .bss slot; the reference
        //      compiles as an unresolved external and is resolved by the
        //      consumer's link against libpdx-audit.
        lea r11, [rip + record_state];
        mov rax, [r11];
        cmp rax, 1;                              // AUDIT_STATE_BEGUN
        je snr_audit_ok;
        cmp rax, 2;                              // AUDIT_STATE_OUTPUT
        je snr_audit_ok;
        mov rax, 6;                              // SR_ERR_NO_AUDIT
        ret;

      snr_audit_ok:
        // ---- Argument gates (pre-prologue, no push/pop required). ----
        cmp rdi, 0;
        je snr_null_name;

        cmp rsi, 0;
        je snr_name_range;
        cmp rsi, 64;                             // SR_MAX_FQNAME_LEN
        ja snr_name_range;

        cmp rdx, 0;
        je snr_null_body;

        // ---- Prologue: preserve four arg regs + hash-capture reg. ----
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                            // rbx = fqname_ptr
        mov r12, rsi;                            // r12 = fqname_len
        mov r13, rdx;                            // r13 = body_ptr
        mov r14, rcx;                            // r14 = body_len

        // ---- Compute content_hash via SchemaHash's trio. -------------
        call schema_hash_init;

        mov rdi, r13;                            // ptr
        mov rsi, r14;                            // len
        call schema_hash_update;
        // Return discarded — init just ran so INACTIVE cannot fire.

        call schema_hash_finalize;
        mov r15, rax;                            // r15 = content_hash

        // =============================================================
        // Dedup scan: any OCCUPIED slot with matching content_hash?
        // =============================================================
        xor rcx, rcx;                            // rcx = i = 0

      snr_dedup_head:
        cmp rcx, 32;                             // SR_MAX_SCHEMAS
        jae snr_dedup_done;

        // rax = schema_slot_state[i]
        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];

        cmp rax, 1;                              // SR_SLOT_OCCUPIED
        jne snr_dedup_advance;

        // rax = schema_content_hash[i]
        lea r11, [rip + schema_content_hash];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];

        cmp rax, r15;
        jne snr_dedup_advance;

        // Match — return the existing slot's id.
        lea r11, [rip + schema_id];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        jmp snr_epilogue;

      snr_dedup_advance:
        add rcx, 1;
        jmp snr_dedup_head;

      snr_dedup_done:
        // =============================================================
        // Free-slot scan: first EMPTY slot wins.
        // =============================================================
        xor rcx, rcx;                            // rcx = i = 0

      snr_free_head:
        cmp rcx, 32;                             // SR_MAX_SCHEMAS
        jae snr_no_space;

        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];

        cmp rax, 0;                              // SR_SLOT_EMPTY
        je snr_free_found;

        add rcx, 1;
        jmp snr_free_head;

      snr_no_space:
        mov rax, 4;                              // SR_ERR_ENOSPC
        jmp snr_epilogue;

      snr_free_found:
        // =============================================================
        // Allocate id from schema_id_next; then populate slot rcx.
        // =============================================================
        lea r11, [rip + schema_id_next];
        mov r8, [r11];                           // r8 = handed-out id
        mov rax, r8;
        add rax, 1;
        mov [r11], rax;                          // schema_id_next += 1

        // schema_id[i] = r8
        lea r11, [rip + schema_id];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r8;

        // schema_content_hash[i] = r15
        lea r11, [rip + schema_content_hash];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r15;

        // schema_fqname_ptr[i] = rbx
        lea r11, [rip + schema_fqname_ptr];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], rbx;

        // schema_fqname_len[i] = r12
        lea r11, [rip + schema_fqname_len];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r12;

        // schema_body_ptr[i] = r13
        lea r11, [rip + schema_body_ptr];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r13;

        // schema_body_len[i] = r14
        lea r11, [rip + schema_body_len];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], r14;

        // schema_slot_state[i] = SR_SLOT_OCCUPIED (1)
        mov rax, 1;
        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov [r10], rax;

        mov rax, r8;                             // return the assigned id

      snr_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      snr_null_name:
        mov rax, 1;                              // SR_ERR_NULL_NAME
        ret;

      snr_name_range:
        mov rax, 2;                              // SR_ERR_NAME_RANGE
        ret;

      snr_null_body:
        mov rax, 3;                              // SR_ERR_NULL_BODY
        ret;
      }
    }

  // ============================================================================
  // schema_lookup(fqname_ptr, fqname_len,
  //               out_id_ptr, out_hash_ptr,
  //               out_body_ptr_ptr, out_body_len_ptr) -> u64
  //
  //   rdi = fqname_ptr         (query)
  //   rsi = fqname_len         (query byte-length; must be in [1, 64])
  //   rdx = out_id_ptr         (nullable; NULL to skip)
  //   rcx = out_hash_ptr       (nullable; NULL to skip)
  //   r8  = out_body_ptr_ptr   (nullable; NULL to skip)
  //   r9  = out_body_len_ptr   (nullable; NULL to skip)
  //
  //   rax = SR_OK              on hit (out-parameters populated)
  //       | SR_ERR_NULL_NAME   (1) if fqname_ptr == 0
  //       | SR_ERR_NAME_RANGE  (2) if fqname_len 0 or > SR_MAX_FQNAME_LEN
  //       | SR_ERR_NOT_FOUND   (5) on miss (no slot's fqname matches)
  //
  // Behavior:
  //   1. Gate query args (null/range) — no state touched on failure.
  //   2. Linear-scan schema_slot_state; for each OCCUPIED slot with
  //      matching fqname_len, byte-compare against the slot's
  //      fqname bytes; the first match wins (dedup at register time
  //      makes duplicate matches impossible for register-through-this-
  //      library callers, but M3-003 wire-mode consumers could in
  //      principle race — first match keeps the semantics stable).
  //   3. On hit: for each non-null out-parameter, write the
  //      corresponding slot field (id, content_hash, body_ptr,
  //      body_len). NULL-tolerant per out-parameter so a caller who
  //      only wants the id passes 0 for the other three.
  //
  // Register plan (5-push prologue = 40 bytes → rsp % 16 = 0 for any
  // hypothetical future nested call; today the function is a pure leaf
  // with no CALL inside so alignment is not observed):
  //   rbx = fqname_ptr         (input; preserved across byte-compare)
  //   r12 = fqname_len         (input; preserved)
  //   r13 = out_id_ptr
  //   r14 = out_hash_ptr
  //   r15 = out_body_ptr_ptr
  //   r9  = out_body_len_ptr   (leaf-preserved caller-save — no nested
  //                             call touches it)
  //   rcx = outer scan counter i
  //   rdi = inner byte-compare index j (repurposed after the copy)
  //   r8  = slot's fqname_ptr scratch (repurposed after the copy)
  //   rax = load / return
  //   rsi, rdx = byte-load scratch inside the compare
  //   r10, r11 = pointer arithmetic scratch (base + i*8)
  //
  // Effects `!{mem} @{}` — pure library-owned read; no syscall.
  // ============================================================================

  pub let schema_lookup : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (fqname_ptr: u64) (fqname_len: u64)
       (out_id_ptr: u64) (out_hash_ptr: u64)
       (out_body_ptr_ptr: u64) (out_body_len_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-schema-registry.M2-003: schema_lookup entry point. Inline pre-prologue gates (avoid a push/pop dance on early error): fqname_ptr == 0 → SR_ERR_NULL_NAME (1); fqname_len == 0 OR > SR_MAX_FQNAME_LEN (64) → SR_ERR_NAME_RANGE (2). 5-push prologue (rbx / r12 / r13 / r14 / r15) copies input pointers into callee-save regs so the outer scan counter (rcx) does not clobber out_hash_ptr (rcx on entry). out_body_len_ptr in r9 stays put — caller-save r9 survives a leaf's execution untouched. Outer scan: xor rcx,rcx; while rcx < 32 (SR_MAX_SCHEMAS): (a) load schema_slot_state[i] via `lea r11,[rip+schema_slot_state]; mov r10,rcx; shl r10,3; add r10,r11; mov rax,[r10]`; skip if != SR_SLOT_OCCUPIED (1); (b) load schema_fqname_len[i]; skip if != r12; (c) load schema_fqname_ptr[i] into r8. Inner byte-compare: xor rdi,rdi (j = 0); while rdi < r12: byte-load caller[j] into rsi and slot[j] into rdx via the `xor sink; mov_b sink,[base + rdi*1]` #1248 mitigation shape (paideia-as SIB folding needs the explicit *1 scale on the index); on cmp rsi,rdx mismatch break to next outer slot; else advance rdi. When the inner loop finishes (rdi == r12), the fqname matched — write outs. NULL-tolerant per-out: `cmp r13,0; je snl_skip_id ; ... mov [r13],rax ; snl_skip_id:` (and analogous for r14/r15/r9); each write loads the corresponding slot array via the same lea+shl+add idiom. Then rax = SR_OK (0), pop the five callee-saves, ret. Miss: after the outer loop exhausts, rax = SR_ERR_NOT_FOUND (5), pop, ret. Every branch uses cmp+jne/je/jae/jb — no test mnemonic. Immediates: 0 (null-check + SR_OK + SR_SLOT_EMPTY compare), 1 (SR_ERR_NULL_NAME / SR_SLOT_OCCUPIED), 2 (SR_ERR_NAME_RANGE), 3 (shl bit count), 5 (SR_ERR_NOT_FOUND), 32 (SR_MAX_SCHEMAS), 64 (SR_MAX_FQNAME_LEN) — all imm8. Label prefix snl_ per project reserved-label discipline.",
      block: {
        // ---- Argument gates (pre-prologue, no push/pop). --------------
        cmp rdi, 0;
        je snl_null_name;

        cmp rsi, 0;
        je snl_name_range;
        cmp rsi, 64;                             // SR_MAX_FQNAME_LEN
        ja snl_name_range;

        // ---- Prologue: move args into callee-saves. -------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                            // fqname_ptr
        mov r12, rsi;                            // fqname_len
        mov r13, rdx;                            // out_id_ptr
        mov r14, rcx;                            // out_hash_ptr
        mov r15, r8;                             // out_body_ptr_ptr
        // r9 = out_body_len_ptr already, no move needed.

        // ---- Outer scan. ---------------------------------------------
        xor rcx, rcx;                            // i = 0

      snl_outer_head:
        cmp rcx, 32;                             // SR_MAX_SCHEMAS
        jae snl_miss;

        // schema_slot_state[i]
        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        cmp rax, 1;                              // SR_SLOT_OCCUPIED
        jne snl_outer_advance;

        // schema_fqname_len[i]
        lea r11, [rip + schema_fqname_len];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        cmp rax, r12;
        jne snl_outer_advance;

        // schema_fqname_ptr[i] into r8
        lea r11, [rip + schema_fqname_ptr];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov r8, [r10];

        // ---- Inner byte-compare loop. ------------------------------
        xor rdi, rdi;                            // j = 0

      snl_inner_head:
        cmp rdi, r12;
        jae snl_hit;

        xor rsi, rsi;
        mov_b rsi, [rbx + rdi * 1];              // caller byte

        xor rdx, rdx;
        mov_b rdx, [r8 + rdi * 1];               // slot byte

        cmp rsi, rdx;
        jne snl_outer_advance;

        add rdi, 1;
        jmp snl_inner_head;

      snl_outer_advance:
        add rcx, 1;
        jmp snl_outer_head;

      snl_hit:
        // ---- NULL-tolerant per-out writes. --------------------------

        // *out_id_ptr = schema_id[i]
        cmp r13, 0;
        je snl_skip_id;
        lea r11, [rip + schema_id];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        mov [r13], rax;

      snl_skip_id:
        // *out_hash_ptr = schema_content_hash[i]
        cmp r14, 0;
        je snl_skip_hash;
        lea r11, [rip + schema_content_hash];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        mov [r14], rax;

      snl_skip_hash:
        // *out_body_ptr_ptr = schema_body_ptr[i]
        cmp r15, 0;
        je snl_skip_body_ptr;
        lea r11, [rip + schema_body_ptr];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        mov [r15], rax;

      snl_skip_body_ptr:
        // *out_body_len_ptr = schema_body_len[i]
        cmp r9, 0;
        je snl_skip_body_len;
        lea r11, [rip + schema_body_len];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        mov [r9], rax;

      snl_skip_body_len:
        xor rax, rax;                            // SR_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      snl_miss:
        mov rax, 5;                              // SR_ERR_NOT_FOUND
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      snl_null_name:
        mov rax, 1;                              // SR_ERR_NULL_NAME
        ret;

      snl_name_range:
        mov rax, 2;                              // SR_ERR_NAME_RANGE
        ret;
      }
    }

  // ============================================================================
  // schema_list(out_ids_ptr, max_count) -> u64
  //   rdi = out_ids_ptr      (nullable when max_count == 0)
  //   rsi = max_count        (0 = probe mode: return count without copy)
  //   rax = count of ids written (write mode) OR count of OCCUPIED
  //         slots (probe mode). Both capped at SR_MAX_SCHEMAS (32).
  //
  // Walks schema_slot_state in ordinal 0..SR_MAX_SCHEMAS order and, for
  // each OCCUPIED slot, writes the slot's schema_id[i] as a u64 into
  // out_ids_ptr[written] until either the catalog is exhausted or
  // written == max_count. Written count is the return value.
  //
  // Probe mode (rsi == 0): the write is short-circuited but the counter
  // still increments for every OCCUPIED slot, so the return value is
  // the total occupied count. A caller sizing a receive buffer can
  // therefore call schema_list(0, 0) first, allocate that many u64
  // slots, then call schema_list(buf, count).
  //
  // Not gated on the M3 audit/elevate machinery — list is a read-side
  // op and the plan treats the catalog as public-read.
  //
  // Register plan (pure leaf; no push/pop, no callee-save touched):
  //   rdi = out_ids_ptr (input)
  //   rsi = max_count (input)
  //   rcx = i (outer slot counter)
  //   r8  = written / occupied counter (return value)
  //   rax = load / return
  //   r10, r11 = pointer arithmetic scratch
  //
  // Effects `!{mem} @{}` — read plus optional write into caller buffer.
  // ============================================================================

  pub let schema_list : (u64, u64) -> u64 !{mem} @{} =
    fn (out_ids_ptr: u64) (max_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-schema-registry.M2-004: schema_list entry point. Pure leaf, no push/pop, no callee-save touched. Register plan: rdi = out_ids_ptr, rsi = max_count, rcx = i (slot counter), r8 = result counter (return value), rax/r10/r11 = scratch. Walks rcx = 0..SR_MAX_SCHEMAS (32) loading schema_slot_state[i] via the standard `lea r11,[rip+base]; mov r10,rcx; shl r10,3; add r10,r11; mov rax,[r10]` idiom. On !OCCUPIED, advance. On OCCUPIED: branch on rsi == 0 (probe mode: `cmp rsi, 0; je snm_count_only`) — probe path skips the write and jumps to r8 += 1 unconditionally, so a probe returns the total occupied count. Write mode: `cmp r8, rsi; jae snm_advance` — stop counting AND writing once capacity is reached, so max_count effectively caps the return value at min(occupied, max_count). Write: load schema_id[i] into rax, compute out_ids_ptr[written] via `mov r10,r8; shl r10,3; add r10,rdi; mov [r10],rax`. Fall through to snm_count_only: `add r8, 1`. Advance: `add rcx, 1; jmp snm_head`. Done: `mov rax, r8; ret`. No test mnemonic. Immediates: 0 (probe-mode gate + SR_SLOT_EMPTY-derived state test), 1 (SR_SLOT_OCCUPIED / increment), 3 (shl bit count), 32 (SR_MAX_SCHEMAS bound) — all imm8. Label prefix snm_ per project reserved-label discipline (snl_ is already taken by schema_lookup so a second unique prefix keeps the linker's local-label table conflict-free).",
      block: {
        xor rcx, rcx;                            // i = 0
        xor r8, r8;                              // result counter = 0

      snm_head:
        cmp rcx, 32;                             // SR_MAX_SCHEMAS
        jae snm_done;

        // schema_slot_state[i]
        lea r11, [rip + schema_slot_state];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];
        cmp rax, 1;                              // SR_SLOT_OCCUPIED
        jne snm_advance;

        // Probe mode: skip the write, count only.
        cmp rsi, 0;
        je snm_count_only;

        // Write mode: cap at max_count.
        cmp r8, rsi;
        jae snm_advance;

        // out_ids_ptr[r8] = schema_id[i]
        lea r11, [rip + schema_id];
        mov r10, rcx;
        shl r10, 3;
        add r10, r11;
        mov rax, [r10];                          // rax = id

        mov r10, r8;
        shl r10, 3;
        add r10, rdi;                            // &out_ids_ptr[r8]
        mov [r10], rax;

      snm_count_only:
        add r8, 1;

      snm_advance:
        add rcx, 1;
        jmp snm_head;

      snm_done:
        mov rax, r8;
        ret;
      }
    }
}
